# PatchPlaner – Konfiguration. Kopieren nach .env und anpassen.

# Port und Adresse, auf der der Server lauscht
PORT=8080
HOST=127.0.0.1

# Wo Datenbank und Grundrisse liegen (relativ zum Programmordner oder absolut)
DATA_DIR=./data

# Öffentliche Adresse – wird für Links in E-Mails und Einladungen genutzt
BASE_URL=https://patchplaner.example.de

# Hinter einem Reverse Proxy (Nginx Proxy Manager, Caddy, Traefik): auf true setzen
TRUST_PROXY=true
# Session-Cookie nur über HTTPS senden: auto | true | false
COOKIE_SECURE=auto

# Maximale Größe für Grundriss-Uploads in MB
MAX_UPLOAD_MB=40

# E-Mail (optional) – für „Passwort vergessen“ und Team-Einladungen per Mail
# Port 465 = SMTPS, 587 = STARTTLS
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=PatchPlaner <patchplaner@example.de>
